# =========================
#  HTTPS — zodplay.space
# =========================
server {
    server_name zodplay.space www.zodplay.space;

    # Site principal (SPA antiga) na raiz
    root  /var/www/holdsafecripto;
    index client.html;

    # Header de debug
    add_header X-Vhost "zodplay-prod" always;

    # Segurança
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    autoindex off;

    # ---------- TESTE DIRETO DO LOCATION ----------
    # Se isso não responder JSON, a requisição nem está chegando neste server.
    location = /zod-board-cache/ping {
        default_type application/json;
        return 200 '{"ok":true,"from":"nginx","host":"zodplay.space"}';
    }

    # ---------- API zod-board-cache ----------
    # /zod-board-cache/... → http://127.0.0.1:3002/...
    location ^~ /zod-board-cache/ {
        proxy_pass         http://127.0.0.1:3002/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        add_header X-Vhost "zod-board-cache" always;
    }

    # ---------- API zod-price-tracker ----------
    # /zod-price-api/... → http://127.0.0.1:3010/...
    location ^~ /zod-price-api/ {
        proxy_pass         http://127.0.0.1:3010/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;

        # CORS headers para permitir acesso do frontend
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
        add_header X-Vhost "zod-price-api" always;

        # Handle preflight requests
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Diagnóstico
    location = /__whoami {
        default_type text/plain;
        add_header X-Vhost "zodplay-prod" always;
        return 200 "ok\n";
    }

    # ACME/LetsEncrypt (usa root herdado)
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    # ===============================
    # BLOQUEIOS
    # ===============================
    location ^~ /.env          { return 404; }
    location ^~ /.env.         { return 404; }
    location ^~ /.git          { return 404; }
    location ^~ /.github       { return 404; }
    location ^~ /.DS_Store     { return 404; }

    location ~ (^|/)\.(?!well-known/) { return 404; }

    location ~* \.(?:env|env\..*|ini|log|conf|config|ya?ml|toml|sql|sqlite3?|bak|backup|old|swp|orig)$ { return 404; }

    location ^~ /node_modules/ { return 404; }
    location ^~ /vendor/       { return 404; }
    location ~* /(composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|yarn\.lock|pipfile|poetry\.lock)$ { return 404; }

    location ~* \.(?:php|cgi|pl|py|sh)$ { return 404; }
    location ~* \.(?:zip|tar|tgz|gz|7z)$ { return 404; }

    # ---------- WebSocket (poker) ----------
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        add_header X-Vhost "zodplay-prod" always;
    }

    # ---------- API (poker) ----------
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        add_header X-Vhost "zodplay-prod" always;
    }

    # ---------- SPA Poker ----------
    location = /poker { return 301 /poker/; }

    location ^~ /poker/ {
        alias /var/www/holdsafecripto/zodpoker/public/;
        index index.html;
        try_files $uri $uri/ /poker/index.html;
        add_header X-Vhost "zodplay-prod" always;
    }

    location ~* ^/poker/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf)$ {
        alias /var/www/holdsafecripto/zodpoker/public/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    # ---------- páginas pontuais ----------
    location = /saque { return 301 /saque/; }

    location ^~ /saque/ {
        try_files /market.html =404;
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "zodplay-prod" always;
    }

    location = /admin.html {
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    location = /vault-withdraw.html    { add_header Cache-Control "no-store" always; add_header X-Vhost "zodplay-prod" always; try_files $uri =404; }
    location = /doc.html        { add_header Cache-Control "no-store" always; add_header X-Vhost "zodplay-prod" always; try_files $uri =404; }
    location = /roadmap.html    { add_header Cache-Control "no-store" always; add_header X-Vhost "zodplay-prod" always; try_files $uri =404; }
    location = /whitepaper.html { add_header Cache-Control "no-store" always; add_header X-Vhost "zodplay-prod" always; try_files $uri =404; }

    # ---------- Front (Vite) em /dist ----------
    location = /dist { return 301 /dist/; }

    # SPA prefixada em /dist/
    location ^~ /dist/ {
        alias /var/www/holdsafecripto/dist/;
        index index.html;
        try_files $uri $uri/ /dist/index.html;
        add_header X-Vhost "zodplay-prod" always;
    }

    # Assets dentro de /dist (cache longo)
    location ~* ^/dist/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|json|map)$ {
        alias /var/www/holdsafecripto/dist/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    # ---------- MAPEAR PEDIDOS NA RAIZ PARA /dist ----------
    location ^~ /assets/ {
        add_header X-Vhost "zodplay-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist$uri =404;
    }

    location = /vite.svg {
        add_header X-Vhost "zodplay-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist/vite.svg =404;
    }

    location ~* ^/(index-[^/]+\.(?:js|css)(?:\.map)?)$ {
        add_header X-Vhost "zodplay-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist/$1 =404;
    }

    # ---------- atalhos ----------
    location = /zodplay       { return 302 /zodplay.html; }
    location = /zodplay/      { return 302 /zodplay.html; }

    location = /zodplay.html {
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    location = /deploy-bscTestnet-97-2025-09-10T22-34-09-224Z.json {
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    # Estáticos gerais
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|json|map)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }

    # HTML sem cache
    location ~* \.html$ {
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "zodplay-prod" always;
        try_files $uri =404;
    }


    # Fallback SPA -> dist/index.html
    location / {
        try_files $uri $uri/ /dist/index.html;
        add_header X-Vhost "4familyzod-prod" always;
    }


    # ---------- TLS ----------
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate     /etc/letsencrypt/live/zodplay.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zodplay.space/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# =========================
#  HTTP -> HTTPS redirect (zodplay)
# =========================
server {
    listen 80;
    listen [::]:80;
    server_name zodplay.space www.zodplay.space;

    # EXCEÇÃO: ACME para HTTP-01
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/holdsafecripto;
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    return 301 https://$host$request_uri;
}

# =========================================================
#  Domínio antigo -> novo (holdsafecripto -> zodplay)
# =========================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name holdsafecripto.com www.holdsafecripto.com;

    ssl_certificate     /etc/letsencrypt/live/holdsafecripto.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/holdsafecripto.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://zodplay.space$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name holdsafecripto.com www.holdsafecripto.com;

    # EXCEÇÃO: ACME
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/holdsafecripto;
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    return 301 https://zodplay.space$request_uri;
}

# =========================================================
#  4familyzod.com — HTTPS (alias do mesmo site)
# =========================================================
server {
    server_name 4familyzod.com www.4familyzod.com;

    root  /var/www/holdsafecripto;
    index dist/index.html;

    add_header X-Vhost "4familyzod-prod" always;

    # Segurança
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    autoindex off;

    # ---------- API zod-board-cache também nesse domínio ----------
    location ^~ /zod-board-cache/ {
        proxy_pass         http://127.0.0.1:3002/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        add_header X-Vhost "zod-board-cache" always;
    }

    # ---------- API zod-price-tracker também nesse domínio ----------
    # /zod-price-api/... → http://127.0.0.1:3010/...
    location ^~ /zod-price-api/ {
        proxy_pass         http://127.0.0.1:3010/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;

        # CORS headers
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
        add_header X-Vhost "zod-price-api" always;

        # Handle preflight requests
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Diagnóstico
    location = /__whoami {
        default_type text/plain;
        add_header X-Vhost "4familyzod-prod" always;
        return 200 "ok\n";
    }

    # ACME também em 443 (renovações)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/holdsafecripto;
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    # WebSocket
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        add_header X-Vhost "4familyzod-prod" always;
    }

    # API
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        add_header X-Vhost "4familyzod-prod" always;
    }

    # Poker
    location = /poker { return 301 /poker/; }

    location ^~ /poker/ {
        alias /var/www/holdsafecripto/zodpoker/public/;
        index index.html;
        try_files $uri $uri/ /poker/index.html;
        add_header X-Vhost "4familyzod-prod" always;
    }

    location ~* ^/poker/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf)$ {
        alias /var/www/holdsafecripto/zodpoker/public/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "4familyzod-prod" always;
        try_files $uri =404;
    }

    # Páginas pontuais
    location = /saque { return 301 /saque/; }

    location ^~ /saque/ {
        try_files /market.html =404;
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "4familyzod-prod" always;
    }

    location = /vault-withdraw.html    { add_header Cache-Control "no-store" always; add_header X-Vhost "4familyzod-prod" always; try_files $uri =404; }
    location = /doc.html        { add_header Cache-Control "no-store" always; add_header X-Vhost "4familyzod-prod" always; try_files $uri =404; }
    location = /roadmap.html    { add_header Cache-Control "no-store" always; add_header X-Vhost "4familyzod-prod" always; try_files $uri =404; }
    location = /whitepaper.html { add_header Cache-Control "no-store" always; add_header X-Vhost "4familyzod-prod" always; try_files $uri =404; }

    # Front (Vite) em /dist
    location = /dist { return 301 /dist/; }

    location ^~ /dist/ {
        alias /var/www/holdsafecripto/dist/;
        index index.html;
        try_files $uri $uri/ /dist/index.html;
        add_header X-Vhost "4familyzod-prod" always;
    }

    location ~* ^/dist/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|json|map)$ {
        alias /var/www/holdsafecripto/dist/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "4familyzod-prod" always;
        try_files $uri =404;
    }

    # Mapear raiz -> /dist
    location ^~ /assets/ {
        add_header X-Vhost "4familyzod-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist$uri =404;
    }

    location = /vite.svg {
        add_header X-Vhost "4familyzod-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist/vite.svg =404;
    }

    location ~* ^/(index-[^/]+\.(?:js|css)(?:\.map)?)$ {
        add_header X-Vhost "4familyzod-prod" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files /dist/$1 =404;
    }

    # Estáticos e HTML
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|json|map)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Vhost "4familyzod-prod" always;
        try_files $uri =404;
    }

    location ~* \.html$ {
        add_header Cache-Control "no-store" always;
        add_header X-Vhost "4familyzod-prod" always;
        try_files $uri =404;
    }

    # Fallback SPA -> AGORA APONTA PARA dist/index.html
    location / {
        try_files $uri $uri/ /dist/index.html;
        add_header X-Vhost "4familyzod-prod" always;
    }

    # TLS
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    ssl_certificate     /etc/letsencrypt/live/4familyzod.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/4familyzod.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# 4familyzod — HTTP -> HTTPS com exceção ACME
server {
    listen 80;
    listen [::]:80;
    server_name 4familyzod.com www.4familyzod.com;

    # EXCEÇÃO: ACME (mesmo webroot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/holdsafecripto;
        default_type "text/plain";
        allow all;
        try_files $uri =404;
    }

    return 301 https://$host$request_uri;
}